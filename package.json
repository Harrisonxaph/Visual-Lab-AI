{
  "name": "visual-labs-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "tsc --noEmit",
    "build": "npm run assets && npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": { "@mediapipe/tasks-vision": "0.10.32" },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
